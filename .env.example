# Distribution site configuration. These touch the landing site only. They are
# never written into the artifact HTML a family saves.

# Load one sample letter into the "try it live" artifact so a visitor sees real
# content without typing. Never set on production.
SEED_DEMO=false

# Error tracking for the site (GlitchTip / Sentry compatible). Leave empty to disable.
SENTRY_DSN=

# Analytics for the site (Umami). Leave empty to disable.
UMAMI_URL=
UMAMI_WEBSITE_ID=
